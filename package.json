{
  "name": "video-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless video generator: GitHub Pages UI + repository_dispatch -> Revideo render -> artifact",
  "scripts": {
    "postinstall": "node scripts/patch-revideo.mjs",
    "typecheck": "tsc --noEmit",
    "render": "node render.mjs"
  },
  "dependencies": {
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0",
    "lucide-static": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.2"
  }
}
